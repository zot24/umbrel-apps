# syntax=docker/dockerfile:1

# Herdr Umbrel app image.
#
# Ships:
#   - herdr v0.9.3 (pinned release binary, sha256-verified per arch)
#   - ttyd web terminal (the Umbrel app UI, behind Umbrel's app proxy auth)
#   - agent-bridge (internal HTTP API on :7682 for sibling apps — NOT proxied)
#   - sshd (key-only SSH straight into the app on :7683 — phone/laptop attach)
#   - moshi-hook (Easy Pair QR + agent approvals from the Moshi phone app)
#   - mosh + tmux + openssh-client (Moshi preflight; Herdr is the multiplexer)
#   - Node.js 22 + npm (agent CLIs install into the persistent /data volume)
#   - git, curl, gh (GitHub CLI for agent workflows inside the box)
#   - bubblewrap (the system bwrap Codex's Linux sandbox looks for at
#     /usr/bin/bwrap; see the README for the container settings it also needs)
#
# Multi-arch: built with docker buildx for linux/amd64 + linux/arm64;
# TARGETARCH selects the matching pinned herdr binary.

FROM node:22-bookworm-slim

ARG HERDR_VERSION=0.9.3
# herdr releases don't publish checksums. These were computed from the
# v0.9.3 release assets on 2026-10-06; bump them together with HERDR_VERSION.
# Regenerated by zot24-herdr/ci/update-deps.sh
ARG HERDR_SHA256_X86_64=18a8dc65f1c2fa485884344356dea1cfd911c6f06cf46fa78e193f4087f4dba7
ARG HERDR_SHA256_AARCH64=4de7aa3e25678812e92960de64f7c2aaa1bca1f0f80a3c5e559837e231e1f5c0

# ttyd is not in the Debian bookworm repos, so pin the upstream static
# binary instead. Hashes verified against the release's SHA256SUMS file.
ARG TTYD_VERSION=1.7.7
ARG TTYD_SHA256_X86_64=8a217c968aba172e0dbf3f34447218dc015bc4d5e59bf51db2f2cd12b7be4f55
ARG TTYD_SHA256_AARCH64=b38acadd89d1d396a0f5649aa52c539edbad07f4bc7348b27b4f4b7219dd4165

# GitHub CLI — install from official apt repo (bookworm).
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bubblewrap \
        ca-certificates \
        curl \
        git \
        gnupg \
        gosu \
        mosh \
        openssh-client \
        openssh-server \
        tmux \
    && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
        | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg \
    && chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
        > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends gh \
    && rm -rf /var/lib/apt/lists/* \
    # Debian's openssh-server postinst generates host keys at build time. Drop
    # them: an image-baked host key is the SAME key on every installation of
    # this app. The entrypoint generates a per-install key on the /data volume
    # instead (which also keeps the fingerprint stable across app updates).
    && rm -f /etc/ssh/ssh_host_* \
    && gh --version \
    && bwrap --version

# Pinned herdr + ttyd binaries, each verified against the recorded sha256
# for the arch.
ARG TARGETARCH
RUN set -eux; \
    case "$TARGETARCH" in \
        amd64)  arch=x86_64;  herdr_sha="$HERDR_SHA256_X86_64"; ttyd_sha="$TTYD_SHA256_X86_64" ;; \
        arm64)  arch=aarch64; herdr_sha="$HERDR_SHA256_AARCH64"; ttyd_sha="$TTYD_SHA256_AARCH64" ;; \
        *) echo "unsupported TARGETARCH: $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /usr/local/bin/herdr \
        "https://github.com/ogulcancelik/herdr/releases/download/v${HERDR_VERSION}/herdr-linux-${arch}"; \
    echo "${herdr_sha}  /usr/local/bin/herdr" | sha256sum -c -; \
    curl -fsSL -o /usr/local/bin/ttyd \
        "https://github.com/tsl0922/ttyd/releases/download/${TTYD_VERSION}/ttyd.${arch}"; \
    echo "${ttyd_sha}  /usr/local/bin/ttyd" | sha256sum -c -; \
    chmod +x /usr/local/bin/herdr /usr/local/bin/ttyd; \
    herdr --version; \
    ttyd --version

# moshi-hook: Easy Pair QR + agent-hook daemon. Pinned tarball + sha256,
# same pattern as herdr/ttyd. Linux arch names match cdn.getmoshi.app.
ARG MOSHI_HOOK_VERSION=0.4.18
ARG MOSHI_HOOK_SHA256_X86_64=169769b63700541683ca46f2bdb2d7e8f6c194547a315bf03f9e8fcc4b11c02d
ARG MOSHI_HOOK_SHA256_AARCH64=06644316b01a50615458a94f700177ae63b37366f8a5efd030651c349e1d27c4
ARG TARGETARCH
RUN set -eux; \
    case "$TARGETARCH" in \
        amd64)  mosh_arch=x86_64; moshi_sha="$MOSHI_HOOK_SHA256_X86_64" ;; \
        arm64)  mosh_arch=arm64;  moshi_sha="$MOSHI_HOOK_SHA256_AARCH64" ;; \
        *) echo "unsupported TARGETARCH: $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /tmp/moshi-hook.tgz \
        "https://cdn.getmoshi.app/hook/v${MOSHI_HOOK_VERSION}/moshi-hook_Linux_${mosh_arch}.tar.gz"; \
    echo "${moshi_sha}  /tmp/moshi-hook.tgz" | sha256sum -c -; \
    tar -xzf /tmp/moshi-hook.tgz -C /tmp moshi-hook; \
    install -m 0755 /tmp/moshi-hook /usr/local/bin/moshi-hook; \
    ln -sf moshi-hook /usr/local/bin/moshi; \
    rm -f /tmp/moshi-hook /tmp/moshi-hook.tgz; \
    moshi-hook version

COPY entrypoint.sh /entrypoint.sh
COPY agent-bridge.mjs web-gate.mjs bootstrap-agents.sh ssh-login.sh /usr/local/lib/herdr-umbrel/
COPY web /usr/local/lib/herdr-umbrel/web
RUN chmod +x /entrypoint.sh \
        /usr/local/lib/herdr-umbrel/bootstrap-agents.sh \
        /usr/local/lib/herdr-umbrel/ssh-login.sh \
    && chmod 644 /usr/local/lib/herdr-umbrel/agent-bridge.mjs \
                 /usr/local/lib/herdr-umbrel/web-gate.mjs

# HOME must live on the Umbrel-managed volume so ~/.config/herdr (config,
# socket, session state, logs), npm-global agent CLIs, and workspaces all
# persist across container rebuilds and app updates.
#
# ENV alone is not enough: gosu sets HOME from the target user's passwd entry
# when dropping privileges, so point the node user's passwd home at /data as
# well. That also covers any tool that resolves home via getpwuid instead of
# $HOME.
#
# /usr/local/bin leads PATH so the image's pinned herdr / moshi-hook / ttyd
# always win over stale copies an older installer left on the volume (e.g.
# /data/.local/bin/moshi-hook); otherwise an image bump silently does nothing.
RUN usermod --home /data node
ENV HOME=/data \
    NPM_CONFIG_PREFIX=/data/.npm-global \
    PATH="/usr/local/bin:/data/.npm-global/bin:/data/.grok/bin:/data/.local/bin:/data/.kimi/bin:/data/.kimi-code/bin:${PATH}" \
    LANG=C.UTF-8 \
    TERM=xterm-256color \
    HERDR_AGENT_PORT=7682 \
    HERDR_SSH_PORT=7683 \
    HERDR_TTYD_PORT=7684 \
    HERDR_GATE_PORT=7681

# 7681 web-gate (via app_proxy) · 7682 agent-bridge (internal, Hermes) ·
# 7683 sshd (published on the host by docker-compose.yml) · 7684 ttyd (localhost).
EXPOSE 7681 7682 7683

# The base image's unprivileged `node` user (UID 1000) is the runtime user.
# We still start as root so the entrypoint can chown the Umbrel-mounted /data
# volume; it drops to `node` via gosu before starting anything.
ENTRYPOINT ["/entrypoint.sh"]
