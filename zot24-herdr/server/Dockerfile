# syntax=docker/dockerfile:1

# Herdr Umbrel app image.
#
# Ships:
#   - herdr-core (hc) v0.1.22 (pinned release tarball, sha256-verified per
#     arch): the runtime. The Herdr desktop and phone apps reach it over SSH
#     on :7683; the web terminal opens its terminal picker.
#   - ttyd web terminal (the Umbrel app UI, behind Umbrel's app proxy auth)
#   - sshd (key-only SSH straight into the app on :7683 — desktop/phone attach)
#   - moshi-hook (Easy Pair QR, agent approvals, and the herdr-core session
#     picker in the Moshi phone app)
#   - mosh + tmux + openssh-client (Moshi preflight)
#   - Node.js 22 + npm (agent CLIs install into the persistent /data volume)
#   - git, curl, gh (GitHub CLI for agent workflows inside the box)
#   - bubblewrap (the system bwrap Codex's Linux sandbox looks for at
#     /usr/bin/bwrap; see the README for the container settings it also needs)
#
# Multi-arch: built with docker buildx for linux/amd64 + linux/arm64;
# TARGETARCH selects the matching pinned binaries.

FROM node:22-bookworm-slim@sha256:de170b39439eb0e5a3444ad7d60b015614a381e10fecae2e30ec9e735122f38d

# herdr-core is released on releases.herdr.dev, not GitHub. Its manifest
# (core/<version>/manifest.json) lists each tarball's sha256; these match it.
# Regenerated by zot24-herdr/ci/update-deps.sh
ARG HC_VERSION=0.1.22
ARG HC_SHA256_X86_64=3054ec3992ce80c5715d721caa9dcefa6056721d15dc113f4750afce763ba5df
ARG HC_SHA256_AARCH64=98757985245d45f8d73dd85e68b139b7f167c28488bb89edd9834c3f5a5cf4cf

# ttyd is not in the Debian bookworm repos, so pin the upstream static
# binary instead. Hashes verified against the release's SHA256SUMS file.
ARG TTYD_VERSION=1.7.7
ARG TTYD_SHA256_X86_64=8a217c968aba172e0dbf3f34447218dc015bc4d5e59bf51db2f2cd12b7be4f55
ARG TTYD_SHA256_AARCH64=b38acadd89d1d396a0f5649aa52c539edbad07f4bc7348b27b4f4b7219dd4165

# GitHub CLI — install from official apt repo (bookworm).
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bubblewrap \
        ca-certificates \
        curl \
        git \
        gnupg \
        gosu \
        jq \
        mosh \
        openssh-client \
        openssh-server \
        tmux \
    && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
        | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg \
    && chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
        > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends gh \
    && rm -rf /var/lib/apt/lists/* \
    # Debian's openssh-server postinst generates host keys at build time. Drop
    # them: an image-baked host key is the SAME key on every installation of
    # this app. The entrypoint generates a per-install key on the /data volume
    # instead (which also keeps the fingerprint stable across app updates).
    && rm -f /etc/ssh/ssh_host_* \
    && gh --version \
    && bwrap --version

# Pinned ttyd binary, verified against the recorded sha256 for the arch.
ARG TARGETARCH
RUN set -eux; \
    case "$TARGETARCH" in \
        amd64)  arch=x86_64;  ttyd_sha="$TTYD_SHA256_X86_64" ;; \
        arm64)  arch=aarch64; ttyd_sha="$TTYD_SHA256_AARCH64" ;; \
        *) echo "unsupported TARGETARCH: $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /usr/local/bin/ttyd \
        "https://github.com/tsl0922/ttyd/releases/download/${TTYD_VERSION}/ttyd.${arch}"; \
    echo "${ttyd_sha}  /usr/local/bin/ttyd" | sha256sum -c -; \
    chmod +x /usr/local/bin/ttyd; \
    ttyd --version

# herdr-core (hc): the runtime the Herdr desktop and phone apps add as an SSH
# machine. A machine add looks for `herdr-core` on PATH before ~/.local/bin,
# so the image's copy is the one SSH clients reach. Linux builds are static.
ARG TARGETARCH
RUN set -eux; \
    case "$TARGETARCH" in \
        amd64)  arch=x86_64;  hc_sha="$HC_SHA256_X86_64" ;; \
        arm64)  arch=aarch64; hc_sha="$HC_SHA256_AARCH64" ;; \
        *) echo "unsupported TARGETARCH: $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /tmp/herdr-core.tgz \
        "https://releases.herdr.dev/core/${HC_VERSION}/herdr-core-linux-${arch}.tar.gz"; \
    echo "${hc_sha}  /tmp/herdr-core.tgz" | sha256sum -c -; \
    tar -xzf /tmp/herdr-core.tgz -C /tmp herdr-core; \
    install -m 0755 /tmp/herdr-core /usr/local/bin/herdr-core; \
    ln -sf herdr-core /usr/local/bin/hc; \
    rm -f /tmp/herdr-core /tmp/herdr-core.tgz; \
    hc --version

# moshi-hook: Easy Pair QR + agent-hook daemon. Pinned tarball + sha256,
# same pattern as herdr-core/ttyd. Linux arch names match cdn.getmoshi.app.
ARG MOSHI_HOOK_VERSION=0.4.62
ARG MOSHI_HOOK_SHA256_X86_64=06e81d91275c5cc215cda9db76f78b3c313c40d8669e910a11698fea9d841cd8
ARG MOSHI_HOOK_SHA256_AARCH64=d894e415c5e287cb36ec713008be7efadde63c8a72efab0f7dee3b5c53f27ba9
ARG TARGETARCH
RUN set -eux; \
    case "$TARGETARCH" in \
        amd64)  mosh_arch=x86_64; moshi_sha="$MOSHI_HOOK_SHA256_X86_64" ;; \
        arm64)  mosh_arch=arm64;  moshi_sha="$MOSHI_HOOK_SHA256_AARCH64" ;; \
        *) echo "unsupported TARGETARCH: $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /tmp/moshi-hook.tgz \
        "https://cdn.getmoshi.app/hook/v${MOSHI_HOOK_VERSION}/moshi-hook_Linux_${mosh_arch}.tar.gz"; \
    echo "${moshi_sha}  /tmp/moshi-hook.tgz" | sha256sum -c -; \
    tar -xzf /tmp/moshi-hook.tgz -C /tmp moshi-hook; \
    install -m 0755 /tmp/moshi-hook /usr/local/bin/moshi-hook; \
    ln -sf moshi-hook /usr/local/bin/moshi; \
    rm -f /tmp/moshi-hook /tmp/moshi-hook.tgz; \
    moshi-hook version

COPY entrypoint.sh /entrypoint.sh
COPY web-gate.mjs bootstrap-agents.sh ssh-login.sh attach-shell.sh /usr/local/lib/herdr-umbrel/
# Named bash so the Herdr desktop app labels its terminals as shells; see the file.
COPY login-shell.sh /usr/local/lib/herdr-umbrel/login/bash
COPY web /usr/local/lib/herdr-umbrel/web
RUN chmod +x /entrypoint.sh \
        /usr/local/lib/herdr-umbrel/bootstrap-agents.sh \
        /usr/local/lib/herdr-umbrel/ssh-login.sh \
        /usr/local/lib/herdr-umbrel/attach-shell.sh \
        /usr/local/lib/herdr-umbrel/login/bash \
    && chmod 644 /usr/local/lib/herdr-umbrel/web-gate.mjs

# HOME must live on the Umbrel-managed volume so herdr-core's state (sockets,
# terminal records, saved screens), npm-global agent CLIs, and workspaces all
# persist across container rebuilds and app updates.
#
# ENV alone is not enough: gosu sets HOME from the target user's passwd entry
# when dropping privileges, so point the node user's passwd home at /data as
# well. That also covers any tool that resolves home via getpwuid instead of
# $HOME.
#
# /usr/local/bin leads PATH so the image's pinned hc / moshi-hook / ttyd
# always win over stale copies an older installer left on the volume (e.g.
# /data/.local/bin/moshi-hook); otherwise an image bump silently does nothing.
RUN usermod --home /data node
ENV HOME=/data \
    NPM_CONFIG_PREFIX=/data/.npm-global \
    PATH="/usr/local/bin:/data/.npm-global/bin:/data/.grok/bin:/data/.local/bin:/data/.kimi/bin:/data/.kimi-code/bin:${PATH}" \
    LANG=C.UTF-8 \
    TERM=xterm-256color \
    HERDR_SSH_PORT=7683 \
    HERDR_TTYD_PORT=7684 \
    HERDR_GATE_PORT=7681

# 7681 web-gate (via app_proxy) · 7683 sshd (published on the host by
# docker-compose.yml) · 7684 ttyd (localhost).
EXPOSE 7681 7683

# The base image's unprivileged `node` user (UID 1000) is the runtime user.
# We still start as root so the entrypoint can chown the Umbrel-mounted /data
# volume; it drops to `node` via gosu before starting anything.
ENTRYPOINT ["/entrypoint.sh"]
