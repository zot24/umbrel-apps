# @defaultRequired=false @defaultSensitive=false
# Local docker-compose.local.yml only.
# On Umbrel, APP_SEED and APP_PASSWORD come from the app runtime.
# Do not commit values for the sensitive items.

# 64 or more characters. openssl rand -hex 32.
# @required
# @sensitive
# @type=string
SESSION_SECRET_KEY=

# email:password for the first admin. Ignored once a user exists.
# The password must not contain a colon.
# @required
# @sensitive
# @type=string
CREATE_SUPERUSER=

# Address written into DSNs. Include the scheme and port.
# @type=string
PUBLIC_URL=http://127.0.0.1:8686
